# Copie este arquivo para .env.local e ajuste os valores.
# Tudo aqui e NEXT_PUBLIC_*: vai para o bundle do navegador.
# Nunca coloque segredo (chave de API, token, senha) num NEXT_PUBLIC_.

# Identidade exibida na aba do navegador e no card de compartilhamento.
NEXT_PUBLIC_SITE_NAME=Memorial Redentorista
NEXT_PUBLIC_SITE_TITLE=Doação - Memorial Redentorista.
NEXT_PUBLIC_SITE_DESCRIPTION=Sua doação mantém viva esta missão de fé, evangelização e caridade.

# Titulo curto usado no card de compartilhamento (WhatsApp, redes sociais).
NEXT_PUBLIC_SHARE_TITLE=De algo maior
